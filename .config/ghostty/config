# ─── Theme ───

# Ghostty ships with 250+ built-in themes. A few great dark options:
# Catppuccin Mocha | Tokyo Night | Rose Pine | Gruvbox Dark | nord
# Run `ghostty +list-themes` to browse all of them.
theme = Material Design Colors (custom)
# uses ansi theme in yazi file previews (using bat), so keep in mind if want to use same in vim

# Options: official, blueprint, chalkboard, microchip, glass,
# holographic, paper, retro, xray, custom
macos-icon = microchip

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
custom-shader = ~/.config/ghostty/shaders/just-stars.glsl
custom-shader-animation = always

# ─── Fonts ───

font-size = 14
font-family = MonaspiceNe NFM
font-family-italic = MonaspiceRn NFM
font-family-bold-italic = MonaspiceRn NFM
# OpenType features
font-feature = calt, liga, ss01, ss02, ss03, ss04, ss09, cv01=2, cv02=1, cv10=1, cv19=1, cv31=1
font-thicken = true


# ─── Window ───

# Changing this configuration might require restarting Ghostty completely.
title = 👻
background-opacity = 0.95
background-blur = 10
background-image = /Users/vishudh/Pictures/Wallpapers/322501.jpg
background-image-opacity = 0.2
background-image-fit = cover
maximize = true
# Don't prompt when closing a tab/window
confirm-close-surface = false
# macos-titlebar-style = tabs
macos-titlebar-style = hidden
quit-after-last-window-closed = true
window-padding-balance = true
# srgb looked washed out
window-colorspace = display-p3


# ─── Shell integration ───

# Ghostty auto-injects its own shell integration for zsh.
# Features: https://ghostty.org/docs/config/reference#shell-integration-features
shell-integration = zsh
shell-integration-features = no-cursor

# Change default behavior so that option is treated as alt
macos-option-as-alt = left


# ─── Keybindings ───

# Split navigation
keybind = cmd+r=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+r=new_split:right
keybind = cmd+shift+r=new_split:left
keybind = cmd+d=new_split:down
keybind = cmd+shift+d=new_split:up

# Tab navigation
# keybind = cmd+option+right=next_tab
# keybind = cmd+option+left=previous_tab
