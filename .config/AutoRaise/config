# How often to poll the mouse position and consider a raise/focus.
# Lower values increase responsiveness but also CPU load.
# Minimum = 20
pollMillis=50

# Raise delay, specified in units of pollMillis. Disabled if 0
delay=1

# 0–1, horizontal warp target on cmd-tab. Remove line to disable
warpX=0.5

# 0–1, vertical warp target on cmd-tab. Remove line to disable
warpY=0.5

# Enlarge the mouse for a short period of time after warping it
scale=1.0

# Require the mouse to stop moving before raise/focus
requireMouseStop=false

# comma-separated apps to exclude, e.g. "IntelliJ IDEA,1Password"
ignoreApps=""

# control | option | disabled — hold to temporarily suppress AutoRaise
disableKey="control"
